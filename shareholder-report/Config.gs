/**
 * 株主向け日報システム — 設定ファイル
 *
 * 触るのは基本このファイルだけ。ロジックは Code.gs にある。
 */

var CONFIG = {
  // ── 対象カレンダー ──────────────────────────────
  // 'primary' は自分のメインカレンダー。
  // 部門カレンダーなども見たい場合はカレンダー ID を追加する。
  //   例: ['primary', 'xxxx@group.calendar.google.com']
  CALENDAR_IDS: ['primary'],

  // ── 素材メールの宛先 ────────────────────────────
  // 空文字なら、スクリプトを実行している自分自身のアドレスに送る。
  RECIPIENT: '',

  // ── 対象日 ──────────────────────────────────────
  // 0 = 実行した当日 / 1 = 前日。
  // 当日の夜に送るなら 0、翌朝に送るなら 1 にする。
  DAY_OFFSET: 0,

  // ── 議事録の探索場所 ────────────────────────────
  // Google Meet の文字起こし・メモが保存されるフォルダ ID を入れる。
  // （Drive の「Meet Recordings」フォルダを開き、URL 末尾の文字列がフォルダ ID）
  // 空配列のままなら、ドライブ全体を「予定タイトルとの一致」で検索する。
  MINUTES_FOLDER_IDS: [],

  // ── 収集の条件 ──────────────────────────────────
  INCLUDE_ALL_DAY: false,   // 終日予定も素材に含めるか
  SKIP_DECLINED: true,      // 自分が「欠席」で回答した予定を除外するか
  SEND_WHEN_EMPTY: false,   // 予定が 0 件の日でもメールを送るか

  // ── 分量の上限 ──────────────────────────────────
  MAX_DOC_CHARS: 12000,     // 議事録 1 本あたりの取り込み上限
  MAX_TOTAL_CHARS: 60000,   // 素材全体の上限（Gmail の表示崩れ防止）

  // ── 自動実行の時刻 ──────────────────────────────
  TRIGGER_HOUR: 19          // createDailyTrigger() が設定する時刻（0〜23）
};

/**
 * Claude に渡す指示文。素材メールの先頭にそのまま入る。
 * 日報の書きぶりを変えたいときは、ここだけ書き換えれば良い。
 */
function buildPrompt_(dateLabel) {
  return [
    'あなたは私の会社の広報担当です。以下の「素材」は ' + dateLabel + ' の私のカレンダー予定と、',
    'その会議の議事録・文字起こしです。これをもとに、株主向けの日報を作成してください。',
    '',
    '# 出力フォーマット',
    '━━━━━━━━━━━━━━',
    '📅 ' + dateLabel + ' 日報',
    '',
    '【本日の動き】',
    '・（何をしたか。会議単位ではなく、意味のあるまとまりで 2〜4 行）',
    '',
    '【決定事項】',
    '・（その日に決まったこと。なければ「特記なし」）',
    '',
    '【次の一手】',
    '・（次に動くこと・期限があるもの。なければ「特記なし」）',
    '━━━━━━━━━━━━━━',
    '',
    '# 作成ルール',
    '- 全体で 300〜500 字。LINE で 1 通として読み切れる分量にする。',
    '- 読み手は社外の株主。社内の略語・人物のあだ名・プロジェクトコード名は、意味の分かる言葉に開く。',
    '- 素材に書かれていない事実を推測で補わない。書けることが無いブロックは「特記なし」とする。',
    '- 金額・件数・日付・社名は、素材にある通りに正確に引用する。丸めたり盛ったりしない。',
    '- 未確定の資金調達、人事・処遇、係争、他社との未締結の交渉など、外に出ると差し支える可能性がある',
    '  内容は、断定を避けて概括にとどめるか省く。判断に迷うものは日報の末尾に',
    '  「※要確認: 〜」として別掲し、本文には入れない。',
    '- 絵文字は見出しの範囲にとどめ、本文では使わない。',
    '',
    '# 素材',
    ''
  ].join('\n');
}
